ter;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="396" y="300" width="49" height="50" as="geometry"/></mxCell><mxCell id="p14-b34" value="Übertragung&lt;br&gt;1.30 s" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="445" y="300" width="429" height="50" as="geometry"/></mxCell><mxCell id="p14-b35" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="875" y="300" width="26" height="50" as="geometry"/></mxCell><mxCell id="p14-b36" value="&lt;b&gt;≈ 1,73 s – knapp&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#b46504;" vertex="1" parent="1"><mxGeometry x="909" y="300" width="210" height="50" as="geometry"/></mxCell><mxCell id="p14-b37" value="Langsame Leitung&lt;br&gt;115 200 Baud, 30 KB" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="270" height="50" as="geometry"/></mxCell><mxCell id="p14-b38" value="Fallen&lt;br&gt;0.20 s" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="385" width="66" height="50" as="geometry"/></mxCell><mxCell id="p14-b39" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="396" y="385" width="49" height="50" as="geometry"/></mxCell><mxCell id="p14-b40" value="Übertragung&lt;br&gt;2.60 s" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="445" y="385" width="859" height="50" as="geometry"/></mxCell><mxCell id="p14-b41" value="&lt;b&gt;✗ Foto kommt nach der 2-s-Frist&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1180" y="437" width="210" height="28" as="geometry"/></mxCell><mxCell id="p14-b42" value="&lt;b&gt;Legende&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fillColor=#ffffff;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="200" height="132" as="geometry"/></mxCell><mxCell id="p14-b43" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="52" y="528" width="22" height="18" as="geometry"/></mxCell><mxCell id="p14-b44" value="fällt auf Klappe" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="526" width="156" height="22" as="geometry"/></mxCell><mxCell id="p14-b45" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="52" y="554" width="22" height="18" as="geometry"/></mxCell><mxCell id="p14-b46" value="Kamera macht Foto" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="552" width="156" height="22" as="geometry"/></mxCell><mxCell id="p14-b47" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="52" y="580" width="22" height="18" as="geometry"/></mxCell><mxCell id="p14-b48" value="Foto über USB" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="578" width="156" height="22" as="geometry"/></mxCell><mxCell id="p14-b49" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="52" y="606" width="22" height="18" as="geometry"/></mxCell><mxCell id="p14-b50" value="KI-Erkennung" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="604" width="156" height="22" as="geometry"/></mxCell><mxCell id="p14-b51" value="&lt;b&gt;Was folgt daraus?&lt;/b&gt;&lt;br&gt;• Baudrate ≥ 460 800 (Firmware nutzt 921 600 ✓), Foto ≤ 30 KB&lt;br&gt;• KI-Zeit auf dem Jetson messen: bis ca. 0,3 s unkritisch, ab ca. 0,8 s wird es knapp&lt;br&gt;• Die LED kommt &lt;b&gt;vor&lt;/b&gt; dem Kippen. Kippen (0,6 s) und Weitergaben (je ~1 s) zählen nicht für MUSS-03&lt;br&gt;• Wirft jemand in ein beschäftigtes Modul, wartet der Gegenstand – das ist der einzige Fall über 2 s" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="280" y="500" width="1080" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>