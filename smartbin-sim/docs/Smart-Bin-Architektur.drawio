rgebnis: &lt;b&gt;FEHLWURF_NICHT_UMLENKBAR&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="655" width="290" height="80" as="geometry"/></mxCell><mxCell id="p12-e27" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12-b8" target="p12-b26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12-b28" value="LED &lt;b&gt;rot&lt;/b&gt; (FEHLWURF)&lt;br&gt;SORT: Richtung zum Ziel, 1 oder mehr Hops&lt;br&gt;Ergebnis: &lt;b&gt;FEHLWURF_UMGELENKT&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="545" y="790" width="310" height="85" as="geometry"/></mxCell><mxCell id="p12-e29" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12-b8" target="p12-b28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12-b30" value="&lt;b&gt;«erreichbar» heisst&lt;/b&gt;&lt;br&gt;• neighbour_bin: Ziel liegt direkt neben der Öffnung&lt;br&gt;• via_flaps: alle Module auf dem Weg und das Ziel sind&lt;br&gt;  online und nicht in STOERUNG&lt;br&gt;&lt;b&gt;Richtung:&lt;/b&gt; Ziel links → LINKS, rechts → RECHTS" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="470" height="130" as="geometry"/></mxCell><mxCell id="p12-b31" value="&lt;b&gt;Danach immer&lt;/b&gt; (Seite 11, Schritt 8)&lt;br&gt;SIGNAL + erster SORT an das Modul,&lt;br&gt;Vorgang wird verfolgt, bis der letzte Hop&lt;br&gt;SORT_DONE meldet → Statistik-Zeile" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="790" width="460" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="13 Fehler &amp; Wiederholungen"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p13-b1" value="&lt;b&gt;Was passiert, wenn etwas schiefgeht?&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell><mxCell id="p13-b2" value="Jeder Fehler wird an einer Stelle erkannt und hat eine feste Reaktion. In der Simulation mit bis zu 5 % kaputten Frames geprüft." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1360" height="24" as="geometry"/></mxCell><mxCell id="p13-b3" value="&lt;b&gt;Was geht schief?&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spa