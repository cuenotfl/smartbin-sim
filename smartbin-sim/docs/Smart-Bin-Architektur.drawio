ell><mxCell id="p3-l16" value="Ereignisse" style="html=1;rounded=0;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="210" as="sourcePoint"/><mxPoint x="418" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-l17" value="Befehle" style="html=1;rounded=0;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="370" as="sourcePoint"/><mxPoint x="407" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-l18" value="ClassifierPort" style="html=1;rounded=0;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="869" y="170" as="sourcePoint"/><mxPoint x="980" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-l19" value="ModulePort" style="html=1;rounded=0;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="891" y="290" as="sourcePoint"/><mxPoint x="980" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-l20" value="EventStorePort" style="html=1;rounded=0;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="887" y="410" as="sourcePoint"/><mxPoint x="980" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-l21" value="liest" style="html=1;rounded=0;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="867" y="520" as="sourcePoint"/><mxPoint x="980" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-b22" value="&lt;b&gt;Warum so?&lt;/b&gt; Der Kern lässt sich ohne Hardware testen: In Tests und in der Simulation werden nur die Adapter ausgetauscht (Seite 9). Ein neues Modell oder ein anderes Kabel ändert nur einen Adapter, nie den Kern." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1220" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 ESP32-Firmware"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4-b1" value="&lt;b&gt;ESP32-Firmware: führt aus und passt auf&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1160" height="30" as="geometry"/></mxCell><mxCell id="p4-b2" value="Auf jedem Modul läuft dieselbe Firmware. Sie entscheidet nichts über Fraktionen, aber sie allein darf bewegen." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1160" height="24" as="geometry"/></mxCell><mxCell id="p4-b3" value="&lt;b&gt;smartbin-module&lt;/b&gt; – Firmware (C++), 3× identisch" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fillColor=#d5e8d4;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#f3faf2;" vertex="1" parent="1"><mxGeometry x="300" y="95" width="600" height="410" as="geometry"/></mxCell><mxCell id="p4-b4" value="&lt;b&gt;Safety-Monitor&lt;/b&gt;&lt;br&gt;Hand im Einwurf? Jetson noch da?&lt;br&gt;Timeout? → darf jede Bewegung sperren" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="260" height="75" as="geometry"/></mxCell><mxCell id="p4-b5" value="&lt;b&gt;Zustandsautomat&lt;/b&gt;&lt;br&gt;BEREIT → ERKANNT → WARTEN&lt;br&gt;→ SORTIEREN → BEREIT (Seite 6)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="250" width="260" height="80" as="geometry"/></mxCell><mxCell id="p4-b6" value="&lt;b&gt;PIR-Eingang&lt;/b&gt;&lt;br&gt;Hand erkannt?" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="120" height="60" as="geometry"/></mxCell><mxCell id="p4-b7" value="&lt;b&gt;Protokoll-Link&lt;/b&gt;&lt;br&gt;Frames, CRC,&lt;br&gt;Heartbeat" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="760" y="255" width="125" height="70" as="geometry"/></mxCell><mxCell id="p4-b8" value="&lt;b&gt;Kamera-Treiber&lt;/b&gt;&lt;br&gt;Foto als JPEG" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;stro