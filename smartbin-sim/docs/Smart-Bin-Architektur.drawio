0" height="70" as="geometry"/></mxCell><mxCell id="p3-b6" value="&lt;b&gt;Statistik&lt;/b&gt;&lt;br&gt;ein Eintrag pro Vorgang, ohne Personendaten" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="370" width="360" height="55" as="geometry"/></mxCell><mxCell id="p3-b7" value="&lt;b&gt;Ports&lt;/b&gt; (Schnittstellen, vom Kern definiert):&lt;br&gt;ClassifierPort · ModulePort&lt;br&gt;EventStorePort · Stationskonfiguration" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;dashed=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="440" width="360" height="70" as="geometry"/></mxCell><mxCell id="p3-b8" value="&lt;b&gt;Treibende Adapter&lt;/b&gt; (rufen den Kern auf)" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="24" as="geometry"/></mxCell><mxCell id="p3-b9" value="&lt;b&gt;Serial-Gateway&lt;/b&gt; (Empfang)&lt;br&gt;Meldungen der 3 ESP32 über USB:&lt;br&gt;Gegenstand da, Foto, fertig, Störung" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="280" height="80" as="geometry"/></mxCell><mxCell id="p3-b10" value="&lt;b&gt;Web-Dashboard&lt;/b&gt; (FastAPI, geplant)&lt;br&gt;Statistik ansehen, CSV-Export,&lt;br&gt;Störung quittieren" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;dashed=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent