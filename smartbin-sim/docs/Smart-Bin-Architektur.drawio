parent="1"><mxGeometry x="526" y="515" width="248" height="64" as="geometry"/></mxCell><mxCell id="p9-b20" value="Gestörte Leitung&lt;br&gt;2 % kaputte Nachrichten" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="774" y="515" width="248" height="64" as="geometry"/></mxCell><mxCell id="p9-b21" value="✓ MUSS-01 … 03&lt;br&gt;Bericht" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1022" y="515" width="248" height="64" as="geometry"/></mxCell><mxCell id="p9-b22" value="&lt;b&gt;KI-Assistent (Claude Code)&lt;/b&gt; arbeitet nach CLAUDE.md: erst ein Test, dann der Code · Kern bleibt technikfrei · Protokolländerungen müssen gemeldet werden (Firmware!) · Kriterien werden nie aufgeweicht.&lt;br&gt;&lt;br&gt;&lt;b&gt;Echtes Modell prüfen:&lt;/b&gt; tools/evaluate_model.py mit den Testset-Fotos (Ziel ≥ 90 %)." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="1240" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="10 Nachrichten (Protokoll)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p10-b1" value="&lt;b&gt;Informationsübertragung: Wie sieht eine Nachricht auf dem USB-Kabel aus?&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell><mxCell id="p10-b2" value="Jede Nachricht ist ein «Frame» aus Bytes. 921 600 Baud ≈ 92 000 Bytes pro Sekunde. Zahlen sind little-endian." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1360" height="24" as="geometry"/></mxCell><mxCell id="p10-b3" value="&lt;b&gt;① Aufbau eines Frames&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1360" height="220" as="geometry"/></mxCell><mxCell id="p10-b4" value="&lt;b&gt;0xA5&lt;/b&gt;&lt;br&gt;Start" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="90" height="56" as="geometry"/></mxCell><mxCell id="p10-b5" value="1 Byte" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="173" width="90" height="18" as="geometry"/></mxCell><mxCell id="p10-b6" value="hier beginnt&lt;br&gt;ein Frame" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="193" width="90" height="40" as="geometry"/></mxCell><mxCell id="p10-b7" value="&lt;b&gt;Typ&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="150" y="115" width="90" height="56" as="geometry"/></mxCell><mxCell id="p10-b8" value="1 Byte" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="150" y="173" width="90" height="18" as="geometry"/></mxCell><mxCell id="p10-b9" value="welche&lt;br&gt;Nachricht" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="150" y="193" width="90" height="40" as="geometry"/></mxCell><mxCell id="p10-b10" value="&lt;b&gt;seq&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="115" width="120" height="56" as="geometry"/></mxCell><mxCell id="p10-b11" value="2 Bytes" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="240" y="173" width="120" height="18" as="geometry"/></mxCell><mxCell id="p10-b12" value="Vorgangs-Nr.&lt;br&gt;pro Modul" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="193" width="120" height="40" as="geometry"/></mxCell><mxCell id="p10-b13" value="&lt;b&gt;Länge&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="360" y="115" width="170" height="56" as="geometry"/></mxCell><mxCell id="p10-b14" value="4 Bytes" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="360" y="173" width="170" height="18" as="geometry"/></mxCell><mxCell id="p10-b15" value="Anzahl Bytes&lt;br&gt;Nutzdaten" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="360" y="193" width="170" height="40" as="geometry"/></mxCell><mxCell id="p10-b16" value="&lt;b&gt;CRC-8&lt;/b&gt;&lt;br&gt;Kopf" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="530" y="115" width="110" height="56" as="geometry"/></mxCell><mxCell id="p10-b17" value="1 Byte" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="530" y="173" width="110" height="18" as="geometry"/></mxCell><mxCell id="p10-b18" value="kaputte Länge&lt;br&gt;sofort erkannt" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="530" y="193" width="110" height="40" as="geometry"/></mxCell><mxCell id="p10-b19" value="&lt;b&gt;Nutzdaten&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="115" width="390" height="56" as="geometry"/></mxCell><mxCell id="p10-b20" value="0 … 512 KB" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="640" y="173" width="390" height="18" as="geometry"/></mxCell><mxCell id="p10-b21" value="Inhalt, z. B. Richtung&lt;br&gt;oder JPEG-Foto (~15 KB)" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="193" width="390" height="40" as="geometry"/></mxCell><mxCell id="p10-b22" value="&lt;b&gt;CRC-16&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1030" y="115" width="130" height="56" as="geometry"/></mxCell><mxCell id="p10-b23" value="2 Bytes" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1030" y="173" width="130" height="18" as="geometry"/></mxCell><mxCell id="p10-b24" value="prüft den&lt;br&gt;ganzen Frame" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1030" y="193" width="130" height="40" as="geometry"/></mxCell><mxCell id="p10-b25" value="&lt;b&gt;Beispiel&lt;/b&gt; SORT an Modul, seq 0x1234, «nach LINKS, LED rot»:  &lt;font face='monospace'&gt;a5 | 11 | 34 12 | 02 00 00 00 | d7 | 01 02 | 81 53&lt;/font&gt;  (13 Bytes ≈ 0,14 ms)" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="1280" height="40" as="geometry"/></mxCell><mxCell id="p10-b26" value="&lt;b&gt;② Alle Nachrichten – wer sendet was, wann?&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="1360" height="420" as="geometry"/></mxCell><mxCell id="p10-b27" value="&lt;b&gt;ESP32 → Jetson&lt;/b&gt; (Meldungen)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="640" height="30" as="geometry"/></mxCell><mxCell id="p10-b28" value="&lt;b&gt;Jetson → ESP32&lt;/b&gt; (Befehle)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="720" y="350" width="640" height="30" as="geometry"/></mxCell><mxCell id="p10-b29" value="&lt;b&gt;0x01 HELLO&lt;/b&gt; · Modul-ID · Firmware-Version · Protokoll-Version&lt;br&gt;&lt;i&gt;wann:&lt;/i&gt; beim Einschalten" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="640" height="50" as="geometry"/></mxCell><mxCell id="p10-b30" value="&lt;b&gt;0x02 ITEM_DETECTED&lt;/b&gt; · Quelle: 0 = durch Öffnung (PIR sah Hand), 1 = Weitergabe&lt;br&gt;&lt;i&gt;wann:&lt;/i&gt; Gegenstand liegt auf der Klappe" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="447" width="640" height="50" as="geometry"/></mxCell><mxCell id="p10-b31" value="&lt;b&gt;0x03 IMAGE&lt;/b&gt; · JPEG-Foto (~15 KB)&lt;br&gt;&lt;i&gt;wann:&lt;/i&gt; 0,15 s später; erneut nach 0,6 s ohne SORT" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="504" width="640" height="50" as="geometry"/></mxCell><mxCell id="p10-b32" value="&lt;b&gt;0x04 SORT_DONE&lt;/b&gt; · Ergebnis: 0 = ok, 1 = gehalten, ≥ 2 = Fehler&lt;br&gt;&lt;i&gt;wann:&lt;/i&gt; Klappe wieder in Grundstellung" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="561" width="640" height="50" as="geometry"/></mxCell><mxCell id="p10-b33" value="&lt;b&gt;0x05 FAULT&lt;/b&gt; · Fehlercode (1–5) · aktueller Zustand&lt;br&gt;&lt;i&gt;wann:&lt;/i&gt; sofort bei einem Fehler" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="618" width="640" height="50" as="geometry"/></mxCell><mxCell id="p10-b34" value="&lt;b&gt;0x06 HEARTBEAT&lt;/b&gt; · Zustand · letzte fertige seq · deren Ergebnis&lt;br&gt;&lt;i&gt;wann:&lt;/i&gt; jede Sekunde" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="640" height="50" as="geometry"/></mxCell><mxCell id="p10-b35" value="&lt;b&gt;0x10 CONFIG&lt;/b&gt; · Fraktion · Position · Routing-Variante&lt;br&gt;&lt;i&gt;wann:&lt;/i&gt; als Antwort auf HELLO" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="390" width="640" height="50" as="geometry"/></mxCell><mxCell id="p10-b36" value="&lt;b&gt;0x11 SORT&lt;/b&gt; · Richtung (DIREKT/LINKS/RECHTS/HALTEN) · LED-Muster&lt;br&gt;&lt;i&gt;wann:&lt;/i&gt; nach dem Entscheid, pro Hop" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="447" width="640" height="50" as="geometry"/></mxCell><mxCell id="p10-b37" value="&lt;b&gt;0x12 SIGNAL&lt;/b&gt; · LED-Muster (AUS/OK/FEHLWURF/UNBEKANNT/STOERUNG)&lt;br&gt;&lt;i&gt;wann:&lt;/i&gt; zusammen mit dem ersten SORT" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="504" width="640" height="50" as="geometry"/></mxCell><mxCell id="p10-b38" value="&lt;b&gt;0x06 HEARTBEAT&lt;/b&gt; · leer&lt;br&gt;&lt;i&gt;wann:&lt;/i&gt; jede Sekunde" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="561" width="640" height="50" as="geometry"/></mxCell><mxCell id="p10-b39" value="&lt;b&gt;0x13 RESET_FAULT&lt;/b&gt; · leer&lt;br&gt;&lt;i&gt;wann:&lt;/i&gt; Hausdienst quittiert eine Störung" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="618" width="640" height="50" as="geometry"/></mxCell><mxCell id="p10-b40" value="&lt;b&gt;③ Codes und Regeln&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1360" height="180" as="geometry"/></mxCell><mxCell id="p10-b41" value="&lt;b&gt;Codes in den Nutzdaten&lt;/b&gt; (nie umnummerieren, nur anhängen)&lt;br&gt;Fraktion: PET 0 · ALU 1 · REST 2&lt;br&gt;Richtung: DIREKT 0 · LINKS 1 · RECHTS 2 · HALTEN 3&lt;br&gt;LED: AUS 0 · OK 1 · FEHLWURF 2 · UNBEKANNT 3 · STOERUNG 4&lt;br&gt;Zustand: INIT 0 · BEREIT 1 · ERKANNT 2 · WARTEN 3 · SORTIEREN 4 · STOERUNG 5&lt;br&gt;Fehler: 1 kein SORT · 2 Hand zu lange · 3 Blockade · 4 Jetson stumm · 5 Kamera" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="640" height="135" as="geometry"/></mxCell><mxCell id="p10-b42" value="&lt;b&gt;Regeln (Postel-Prinzip)&lt;/b&gt;&lt;br&gt;• Senden: exakt nach Format, alle Felder gefüllt&lt;br&gt;• Empfangen: unbekannte Typen ignorieren, kaputte Frames verwerfen&lt;br&gt;• Befehle sind pro (Modul, seq) wiederholbar – doppelt ankommen schadet nicht&lt;br&gt;• Testvektoren in tests/test_protocol.py gelten für Python &lt;b&gt;und&lt;/b&gt; C++-Firmware" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="720" y="790" width="640" height="135" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="11 Datenverarbeitung"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p11-b1" value="&lt;b&gt;Verarbeitung im Jetson: vom Byte zur Entscheidung zur Statistik&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell><mxCell id="p11-b2" value="Ein einziger Ablauf, Schritt 1 bis 10. Die Nummern stehen auch in den Boxen." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1360" height="24" as="geometry"/></mxCell><mxCell id="p11-b3" value="&lt;b&gt;① Empfangen&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1360" height="135" as="geometry"/></mxCell><mxCell id="p11-b4" value="&lt;b&gt;1 USB-Bytes&lt;/b&gt;&lt;br&gt;ein Lese-Thread je Modul&lt;br&gt;legt Bytes in eine&lt;br&gt;Warteschlange" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="210" height="90" as="geometry"/></mxCell><mxCell id="p11-b5" value="&lt;b&gt;2 FrameDecoder&lt;/b&gt;&lt;br&gt;Startbyte 0xA5 suchen&lt;br&gt;Kopf-CRC und CRC-16 prüfen&lt;br&gt;Fehler → 1 Byte weiter suchen" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="270" height="90" as="geometry"/></mxCell><mxCell id="p11-b6" value="&lt;b&gt;3 Serial-Gateway&lt;/b&gt;&lt;br&gt;Typ → passende Methode&lt;br&gt;im Kern aufrufen&lt;br&gt;unbekannter Typ → ignorieren" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="230" height="90" as="geometry"/></mxCell><mxCell id="p11-b7" value="&lt;b&gt;4 Fachlicher Kern&lt;/b&gt; (ein Thread, Zeit wird mitgegeben)&lt;br&gt;on_hello · on_item_detected · on_image&lt;br&gt;on_sort_done · on_fault · on_heartbeat&lt;br&gt;tick() alle 100 ms: Heartbeats senden, Fristen prüfen" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="870" y="110" width="490" height="90" as="geometry"/></mxCell><mxCell id="p11-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11-b4" target="p11-b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11-b5" target="p11-b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11-b6" target="p11-b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11-b11" value="&lt;b&gt;② KI-Erkennung (Pipes and Filters) – nur bei IMAGE&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="1360" height="125" as="geometry"/></mxCell><mxCell id="p11-b12" value="&lt;b&gt;5a&lt;/b&gt; JPEG dekodieren&lt;br&gt;(Pillow)" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="264" height="80" as="geometry"/></mxCell><mxCell id="p11-b13" value="&lt;b&gt;5b&lt;/b&gt; skalieren&lt;br&gt;224 × 224 Pixel" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="304" y="270" width="264" height="80" as="geometry"/></mxCell><mxCell id="p11-b14" value="&lt;b&gt;5c&lt;/b&gt; normalisieren&lt;br&gt;RGB, ImageNet-Werte" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="568" y="270" width="264" height="80" as="geometry"/></mxCell><mxCell id="p11-b15" value="&lt;b&gt;5d&lt;/b&gt; Inferenz&lt;br&gt;MobileNet (ONNX / TensorRT)" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="832" y="270" width="264" height="80" as="geometry"/></mxCell><mxCell id="p11-b16" value="&lt;b&gt;5e&lt;/b&gt; Softmax&lt;br&gt;→ Fraktion + Konfidenz" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1096" y="270" width="264" height="80" as="geometry"/></mxCell><mxCell id="p11-e17" value="IMAGE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11-b7" target="p11-b12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="919" y="228"/><mxPoint x="172" y="228"/></Array></mxGeometry></mxCell><mxCell id="p11-b18" value="&lt;b&gt;③ Entscheiden und Befehle senden&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="1360" height="150" as="geometry"/></mxCell><mxCell id="p11-b19" value="&lt;b&gt;6 Fehlwurf-Entscheid&lt;/b&gt; (Seite 12)&lt;br&gt;Konfidenz ≥ 0,6?&lt;br&gt;erkannt = gewählte Öffnung?&lt;br&gt;Ziel erreichbar? → Signal + Route" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="310" height="100" as="geometry"/></mxCell><mxCell id="p11-b20" value="&lt;b&gt;7 Vorgang verfolgen&lt;/b&gt;&lt;br&gt;aktiv: (Modul, seq) → Vorgang&lt;br&gt;unterwegs: am Nachbarmodul erwartet&lt;br&gt;Fristen: Foto 2 s · Sortieren 6 s · Weitergabe +3 s" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="330" height="100" as="geometry"/></mxCell><mxCell id="p11-b21" value="&lt;b&gt;8 Befehle&lt;/b&gt;&lt;br&gt;SIGNAL (LED) + SORT (Richtung + LED)&lt;br&gt;an das Modul, das den Gegenstand&lt;br&gt;gerade hält – Hop für Hop" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="740" y="420" width="300" height="100" as="geometry"/></mxCell><mxCell id="p11-b22" value="&lt;b&gt;9 Frame bauen&lt;/b&gt;&lt;br&gt;Kopf + CRC-8 + Nutzdaten + CRC-16&lt;br&gt;→ USB an das ESP32" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1070" y="420" width="290" height="100" as="geometry"/></mxCell><mxCell id="p11-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11-b16" target="p11-b19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1172" y="378"/><mxPoint x="195" y="378"/></Array></mxGeometry></mxCell><mxCell id="p11-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11-b19" target="p11-b20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11-b20" target="p11-b21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11-b21" target="p11-b22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11-b27" value="&lt;b&gt;④ Speichern und Anzeigen&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="20" y="565" width="1360" height="205" as="geometry"/></mxCell><mxCell id="p11-b28" value="&lt;b&gt;10 Abschluss → eine Statistik-Zeile&lt;/b&gt;&lt;br&gt;Zeit · Vorgang-ID · Modul&lt;br&gt;gewählt · erkannt · Konfidenz&lt;br&gt;Ergebnis (KORREKT, FEHLWURF_UMGELENKT,&lt;br&gt;FEHLWURF_NICHT_UMLENKBAR, UNBEKANNT,&lt;br&gt;ABGEBROCHEN) · Dauer ms · Rückmeldung ms" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="330" height="150" as="geometry"/></mxCell><mxCell id="p11-b29" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;WAL-Modus, sofort gespeichert&lt;br&gt;übersteht Stromausfall" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="610" width="230" height="110" as="geometry"/></mxCell><mxCell id="p11-b30" value="&lt;b&gt;Dashboard&lt;/b&gt; (FastAPI)&lt;br&gt;GET /  → Übersicht&lt;br&gt;GET /api/stats · GET /api/modules&lt;br&gt;POST /api/modules/{id}/reset&lt;br&gt;GET /statistik.csv" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="680" y="595" width="340" height="150" as="geometry"/></mxCell><mxCell id="p11-b31" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;Facility Management, Hausdienst" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="595" width="300" height="65" as="geometry"/></mxCell><mxCell id="p11-b32" value="Fotos werden &lt;b&gt;nie&lt;/b&gt; gespeichert:&lt;br&gt;nur im Arbeitsspeicher, nach der&lt;br&gt;Erkennung verworfen (Datenschutz)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="