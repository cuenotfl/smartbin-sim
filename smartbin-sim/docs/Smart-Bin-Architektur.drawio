Align=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="670" y="676" width="490" height="50" as="geometry"/></mxCell><mxCell id="p13-b54" value="2 s" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1160" y="676" width="140" height="50" as="geometry"/></mxCell><mxCell id="p13-b55" value="&lt;b&gt;Nach einer STOERUNG:&lt;/b&gt; Klappe in Grundstellung, Gegenstand bleibt liegen, LED zeigt Störung. Erst der Hausdienst quittiert (Taster oder Dashboard → RESET_FAULT). Danach wird der liegende Gegenstand neu erkannt." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1260" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="14 Zeitbudget"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p14-b1" value="&lt;b&gt;Zeitbudget: Reicht es für die LED in ≤ 2 Sekunden? (MUSS-03)&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell><mxCell id="p14-b2" value="Übertragungszeit = Bytes × 10 ÷ Baudrate. Kamera- und KI-Zeiten sind Annahmen – am Funktionsmuster messen!" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1360" height="24" as